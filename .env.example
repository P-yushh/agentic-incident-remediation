# Application
AIR_ENVIRONMENT=development
AIR_LOG_LEVEL=INFO
AIR_REDIS_URL=redis://localhost:6379/0
AIR_MAX_REFLECTION_ATTEMPTS=3

# Repository operations (required only for a live approved PR)
AIR_GITHUB_REPOSITORY=P-yushh/agentic-incident-remediation
AIR_GITHUB_BASE_BRANCH=main
GITHUB_TOKEN=

# Model provider
AIR_MODEL_PROVIDER=huggingface
AIR_MODEL_NAME=openai/gpt-oss-20b:cheapest
AIR_MODEL_REASONING_EFFORT=low
AIR_MODEL_MAX_OUTPUT_TOKENS=1200
HF_TOKEN=

# Alternative: Gemini Developer API (replace the two provider/model values above)
# AIR_MODEL_PROVIDER=gemini
# AIR_MODEL_NAME=gemini-3.8-flash
GEMINI_API_KEY=
# Use an unbilled AI Studio project and verify its model quota before calling.
# No automatic provider fallback or request retries are enabled for Gemini.
